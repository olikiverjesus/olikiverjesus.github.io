---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';

const focusAreas = ['AI systems', 'Workflows', 'Orchestration', 'Automation', 'Observability', 'Reliability', 'Operational AI', 'Systems thinking'];
const resources = [
  {
    title: 'Production AI Checklists',
    href: 'https://github.com/signal-layer-labs/production-ai-checklists',
    description: 'Operational checklists for building, shipping, and maintaining AI systems.',
  },
  {
    title: 'Workflow Failure Library',
    href: 'https://github.com/signal-layer-labs/workflow-failure-library',
    description: 'A practical library of failure modes in AI workflows, automation, and production systems.',
  },
  {
    title: 'Signal Layer Builders',
    href: 'https://signal-layer-website.vercel.app',
    description: 'A lightweight directory for builders working on systems, workflows, automation, and AI projects.',
  },
];
---

<BaseLayout title="Signal Layer | Olikiver Barros" description="Signal Layer is a builder ecosystem for operational AI, workflows, automation, observability, reliability, and systems thinking.">
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 lg:px-8">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.26em] text-signal">Signal Layer</p>
    <h1 class="max-w-3xl text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl">Practical infrastructure and resources for builders putting systems into production.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-mist">
      Signal Layer is a small builder ecosystem focused on AI systems, workflows, orchestration, automation, observability, reliability, operational AI, and systems thinking.
    </p>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-10 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="flex flex-wrap gap-2">
        {focusAreas.map((area) => <Tag label={area} />)}
      </div>
      <div class="rounded-lg border border-line/80 bg-white/[0.03] p-5">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-copper">Why it exists</p>
        <p class="mt-4 text-sm leading-6 text-mist">
          Many AI and automation projects look finished at the demo stage but fail in handoffs, monitoring, maintenance, and operational edge cases. Signal Layer collects practical resources for builders who care about those production details.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-4 px-5 pb-16 sm:px-6 md:grid-cols-3 lg:px-8">
    {resources.map((resource) => (
      <a class="rounded-lg border border-line/80 bg-panel/65 p-5 hover:border-signal/50" href={resource.href} target="_blank" rel="noreferrer">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-copper">Public resource</p>
        <h2 class="mt-4 text-xl font-semibold tracking-tight text-white">{resource.title}</h2>
        <p class="mt-3 text-sm leading-6 text-mist">{resource.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>
