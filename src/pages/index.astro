---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Tag from '../components/Tag.astro';
import { featuredProjects } from '../data/projects';
import { writingEntries } from '../data/writing';

const strengths = [
  'Operational AI systems',
  'Workflow automation',
  'Data analytics and reporting',
  'Full-stack product systems',
  'Systems thinking',
  'Open-source builder infrastructure',
];

const proofItems = [
  {
    label: 'Live product',
    title: 'Signal Layer Builders',
    description: 'A directory for builders working on systems, workflows, automation, and technical tools.',
    href: 'https://signal-layer-website.vercel.app',
  },
  {
    label: 'Open resource',
    title: 'Production AI Checklists',
    description: 'Operational checklists for building and maintaining AI systems in real environments.',
    href: 'https://github.com/signal-layer-labs/production-ai-checklists',
  },
  {
    label: 'Open resource',
    title: 'Workflow Failure Library',
    description: 'A practical library of failure modes in AI workflows and automation systems.',
    href: 'https://github.com/signal-layer-labs/workflow-failure-library',
  },
  {
    label: 'Systems work',
    title: 'Analytics and workflow automation',
    description: 'Private operational reporting, process clarity, and internal decision-support systems.',
  },
];
---

<BaseLayout>
  <section class="mx-auto grid min-h-[76vh] w-full max-w-6xl items-center gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[1.18fr_0.82fr] lg:px-8">
    <div>
      <p class="mb-5 font-mono text-xs uppercase tracking-[0.26em] text-signal">Proof-of-work hub</p>
      <h1 class="max-w-4xl text-balance text-4xl font-semibold tracking-tight text-white sm:text-6xl">
        I build operational systems across data, automation, AI workflows, and full-stack products.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-mist">
        Turning messy workflows into reliable systems, tools, and practical infrastructure.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded border border-signal/50 bg-signal/10 px-4 py-2 text-sm font-medium text-white shadow-soft transition hover:bg-signal/15" href="/projects">View projects</a>
        <a class="rounded border border-white/10 bg-white/[0.03] px-4 py-2 text-sm font-medium text-mist transition hover:border-signal/40 hover:text-white" href="/signal-layer">Explore Signal Layer</a>
        <a class="rounded border border-line px-4 py-2 text-sm font-medium text-mist transition hover:border-white/40 hover:text-white" href="/contact">Contact</a>
      </div>
    </div>
    <aside class="rounded-lg border border-white/10 bg-panel/72 p-5 shadow-soft">
      <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-4">
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-copper">Current proof</p>
        <span class="rounded-full border border-signal/25 bg-signal/10 px-2.5 py-1 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-signal">Static hub</span>
      </div>
      <dl class="mt-5 grid gap-3">
        <div class="rounded border border-white/10 bg-white/[0.03] p-4">
          <dt class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist">Public resources</dt>
          <dd class="mt-2 text-2xl font-semibold text-white">2</dd>
        </div>
        <div class="rounded border border-white/10 bg-white/[0.03] p-4">
          <dt class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist">Live builder platform</dt>
          <dd class="mt-2 text-2xl font-semibold text-white">1</dd>
        </div>
        <div class="rounded border border-white/10 bg-white/[0.03] p-4">
          <dt class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-mist">Focus</dt>
          <dd class="mt-2 text-sm leading-6 text-white">Operational AI, workflows, automation</dd>
        </div>
      </dl>
      <p class="mt-5 text-sm leading-6 text-mist">
        Practical infrastructure for AI systems that need to be operated, observed, documented, and improved after a demo works.
      </p>
    </aside>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-8 sm:px-6 lg:px-8">
    <div class="grid gap-3 border-y border-white/10 py-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        proofItems.map((item) => {
          const Wrapper = item.href ? 'a' : 'article';
          const props = item.href ? { href: item.href, target: '_blank', rel: 'noreferrer' } : {};
          return (
            <Wrapper {...props} class="group rounded-lg border border-white/10 bg-white/[0.03] p-4 transition hover:border-signal/40 hover:bg-white/[0.05]">
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-copper">{item.label}</p>
              <h2 class="mt-3 text-base font-semibold tracking-tight text-white">{item.title}</h2>
              <p class="mt-2 text-sm leading-6 text-mist">{item.description}</p>
              {item.href && <span class="mt-4 inline-flex text-sm text-signal">Open</span>}
            </Wrapper>
          );
        })
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {strengths.map((strength) => (
        <div class="rounded-lg border border-white/10 bg-white/[0.03] p-4">
          <p class="text-sm font-medium text-white">{strength}</p>
        </div>
      ))}
    </div>
  </section>

  <Section eyebrow="Selected work" title="Featured Projects" intro="A small set of public systems and resources that show the operating model behind the work.">
    <div class="grid gap-4 md:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  <Section eyebrow="Writing" title="Notes and Resources" intro="Planned writing on systems, reliability, AI workflows, and practical infrastructure.">
    <div class="grid gap-4 md:grid-cols-3">
      {writingEntries.slice(0, 3).map((entry) => (
        <article class="rounded-lg border border-white/10 bg-panel/60 p-5">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-copper">{entry.status}</p>
          <h3 class="mt-4 text-lg font-semibold text-white">{entry.title}</h3>
          <p class="mt-3 text-sm leading-6 text-mist">{entry.description}</p>
          <p class="mt-4 border-l border-signal/30 pl-4 text-sm leading-6 text-mist">{entry.why}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {entry.topics.map((topic) => <Tag label={topic} />)}
          </div>
        </article>
      ))}
    </div>
  </Section>

  <section class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-6 lg:px-8">
    <div class="rounded-lg border border-white/10 bg-white/[0.04] p-6 sm:p-8">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-signal">Contact</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white">Need a system made clearer, more reliable, or easier to operate?</h2>
      <p class="mt-3 max-w-2xl text-base leading-7 text-mist">Reach out for AI workflow design, automation, analytics infrastructure, or practical systems work.</p>
      <a class="mt-6 inline-flex rounded border border-signal/50 bg-signal/10 px-4 py-2 text-sm font-medium text-white transition hover:bg-signal/15" href="/contact">Get in touch</a>
    </div>
  </section>
</BaseLayout>
