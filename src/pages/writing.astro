---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { writingEntries } from '../data/writing';
---

<BaseLayout title="Writing | Olikiver Barros" description="Notes and resources on operational AI, workflow reliability, systems thinking, and practical infrastructure.">
  <section class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-6 lg:px-8">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.26em] text-signal">Writing</p>
    <h1 class="max-w-3xl text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl">Notes on systems that survive contact with real workflows.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-mist">
      Placeholder entries for essays and resources on demos, reliability, automation, and operational AI.
    </p>
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-4 px-5 pb-16 sm:px-6 md:grid-cols-2 lg:px-8">
    {writingEntries.map((entry) => (
      <article class="rounded-lg border border-line/80 bg-panel/65 p-5">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-copper">{entry.status}</p>
        <h2 class="mt-4 text-xl font-semibold tracking-tight text-white">{entry.title}</h2>
        <p class="mt-3 text-sm leading-6 text-mist">{entry.description}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {entry.topics.map((topic) => <Tag label={topic} />)}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
