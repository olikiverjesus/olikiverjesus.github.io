---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/signal-layer', label: 'Signal Layer' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/86 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8" aria-label="Primary navigation">
    <a href="/" class="flex items-center gap-3 text-white" aria-label="Olikiver Barros home">
      <span class="flex size-8 items-center justify-center rounded border border-signal/40 bg-signal/10 font-mono text-sm text-signal">OB</span>
      <span class="font-semibold tracking-tight">Olikiver Barros</span>
    </a>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-mist">
      {
        navItems.map((item) => {
          const active = currentPath === item.href;
          return (
            <a class:list={['transition hover:text-white', active ? 'text-white' : '']} href={item.href} aria-current={active ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }
    </div>
  </nav>
</header>
