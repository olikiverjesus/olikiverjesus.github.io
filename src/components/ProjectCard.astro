---
import Tag from './Tag.astro';
import type { Project } from '../data/projects';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const Wrapper = project.href ? 'a' : 'article';
const wrapperProps = project.href
  ? {
      href: project.href,
      target: '_blank',
      rel: 'noreferrer',
      'aria-label': `${project.title} opens in a new tab`,
    }
  : {};
---

<Wrapper
  {...wrapperProps}
  class="group flex h-full flex-col justify-between rounded-lg border border-line/80 bg-panel/72 p-5 shadow-soft transition duration-200 hover:border-signal/50 hover:bg-panel"
>
  <div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-copper">{project.status ?? 'Project'}</p>
      {project.href && <span class="text-sm text-mist transition group-hover:text-signal">View</span>}
    </div>
    <h3 class="text-xl font-semibold tracking-tight text-white">{project.title}</h3>
    <p class="mt-3 text-sm leading-6 text-mist">{project.description}</p>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    {project.tags.map((tag) => <Tag label={tag} />)}
  </div>
</Wrapper>
