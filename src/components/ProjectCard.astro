---
import Tag from './Tag.astro';
import type { Project } from '../data/projects';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const Wrapper = project.href ? 'a' : 'article';
const wrapperProps = project.href
  ? {
      href: project.href,
      target: '_blank',
      rel: 'noreferrer',
      'aria-label': `${project.title} opens in a new tab`,
    }
  : {};
---

<Wrapper
  {...wrapperProps}
  class="group flex h-full flex-col justify-between rounded-lg border border-white/10 bg-panel/70 p-5 shadow-soft transition duration-200 hover:-translate-y-0.5 hover:border-signal/45 hover:bg-panel/95"
>
  <div>
    <div class="mb-4 flex items-center justify-between gap-4">
      <p class="rounded-full border border-copper/20 bg-copper/10 px-2.5 py-1 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-copper">{project.status ?? 'Project'}</p>
      {project.href && <span class="text-sm text-mist transition group-hover:text-signal">Open</span>}
    </div>
    <h3 class="text-xl font-semibold tracking-tight text-white">{project.title}</h3>
    <p class="mt-4 text-sm leading-6 text-mist">{project.description}</p>
  </div>
  <div class="mt-7 flex flex-wrap gap-2">
    {project.tags.map((tag) => <Tag label={tag} />)}
  </div>
</Wrapper>
